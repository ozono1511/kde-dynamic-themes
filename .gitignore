# No personal data, wallpapers, binaries, active themes, or caches in Git.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
build/
dist/
*.egg-info/
*.log
*.zip
*.tar.*
config/
wallpapers/
backups/
presets/
palettes/
cache/
logs/
bin/
*.colors
*.colorscheme
*.profile
*.png
*.jpg
*.jpeg
*.webp
*.bmp
*.json
!tests/fixtures/*.json
!packaging/*.json
!docs/host.example.json
